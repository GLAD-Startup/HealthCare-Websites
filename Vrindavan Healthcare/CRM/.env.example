# ====================================================================
# VRINDAVAN HEALTHCARE CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# Backend Server Port
PORT=5000

# Local PostgreSQL Database Connection (Standard pg defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrindavan_crm
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vrindavan_crm

# Frontend API Endpoint (pointing to local Node/Express backend)
VITE_API_URL=http://localhost:5000/api

# Meta WhatsApp Cloud API (Optional - CRM falls back to wa.me web/app links seamlessly)
VITE_WHATSAPP_PHONE_NUMBER_ID=
VITE_WHATSAPP_ACCESS_TOKEN=
